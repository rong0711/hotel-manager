<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="hotelmanage.mapper.RoomTypeMapper">
    <select id="selectAll" resultType="hotelmanage.entity.RoomType">
        select * from room_type
    </select>
    <select id="selectById" resultType="hotelmanage.entity.RoomType">
        select * from room_type where id=#{id}
    </select>
</mapper>